# Copy to terraform.tfvars (git-ignored) and replace every <...>. Account IDs are not
# secrets, but they stay out of the repository. Print each one with:
#   aws sts get-caller-identity --profile <profile> --query Account --output text
profile                 = "<governance account CLI profile>"
flower_account_id       = "<Sandbox-43 account ID>"
participant_account_ids = {
  A = "<Sandbox-12 account ID>"
  B = "<Sandbox-33 account ID>"
  C = "<Sandbox-8 account ID>"
}

# Only if the governance host's Name tag is not openhealth-cdi-l0-host:
# governance_host_name = "<Name tag of the governance host>"

