    "status": "proof_of_concept",
    "notes": [
      "This policy is derived from MOU.txt: OPENHEALTH-PATHMNIST-AB version 2.5-draft.",
      "The tuple compiler continues to resolve policy.cap_profiles into policy.ops.",
      "scope.pathology_labels contains canonical PathMNIST identifiers.",
      "The verifier must reject any request containing a label listed in caveats.reserved_pathology_labels.",
      "The issuer and verifier must bind every minted ECT to one envelope_id.",
      "The verifier must require exact equality between the ECT envelope_id and the request envelope_id.",
      "No default capability profile is granted.",
      "Delegation remains constitutionally declared but outside the current PoC enforcement scope.",
      "DPoP freshness and replay protection are enforced by the Gatekeeper and remain orthogonal to the sponsorship policy.",
      "Sponsorship rules are conjunctive across all cap_profiles carried by an ECT.",
      "A cap_profile with no sponsorship_rules entry forbids a non-empty sponsors claim.",
      "Sponsor identities must be constitutionally eligible founding organizations and active participants in the governing envelope.",
      "sponsorship_authority compiles the constitutional set of organizations eligible to sponsor participants."
    ]
  },
  "sponsorship_rules": {
    "capset:pathmnist_guest_contributor": {
