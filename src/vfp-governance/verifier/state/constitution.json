        "mou_rules": [
          "AB-MEMBER-01",
          "AB-MEMBER-02"
        ]
      },
      {
        "org_id": "org://HospitalB",
        "legal_name": "Hospital B",
        "representative_name": "[Director B name]",
        "mou_rules": [
          "AB-MEMBER-01",
          "AB-MEMBER-02"
        ]
      }
    ],
    "default_rule": {
