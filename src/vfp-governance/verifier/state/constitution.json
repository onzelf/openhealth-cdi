          "AB-GUEST-02",
          "AB-GUEST-03",
          "AB-GUEST-04",
          "AB-GUEST-05"
        ],
        "explicit_sponsorship_required": true,
        "minimum_sponsors": 1,
        "maximum_sponsors": 1,
