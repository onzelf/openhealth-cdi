        "required": true,
        "new_actor_within_existing_grade_requires_policy_revision": false,
        "new_grade_requires_constitutional_reapproval": true,
        "mou_rules": [
          "AB-GRADE-01",
          "AB-GRADE-02",
          "AB-GRADE-03"
