    "authorization_context": {
      "principle": "Every authorization is valid only for the particular approved research collaboration for which it was issued.",
      "concurrent_collaborations_may_exist": true,
      "cross_collaboration_reuse_prohibited": true,
      "independent_verifiability_required": true,
      "implementation_note": "The executable policy may represent each approved collaboration with a technical identifier. That identifier is not part of the institutional language.",
      "mou_rules": [
        "AB-CONTEXT-01",
        "AB-CONTEXT-02",
        "AB-CONTEXT-03",
        "AB-CONTEXT-04",
        "AB-CONTEXT-05"
      ]
    },
    "issuer_authority": {
      "authorized_hospitals": [
        "org://HospitalA",
        "org://HospitalB"
      ],
      "issuer_may_grant_only_authorized_roles": true,
      "issuer_authority_must_not_be_exceeded": true,
