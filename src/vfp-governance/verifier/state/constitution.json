      },
      "agent_evaluator": {
        "actor_type": "agent",
        "constitutional_member": false,
        "quorum_rights": false,
        "explicit_sponsorship_required": true,
        "accountability_terminus": "human_or_legal_sponsor",
        "authority": "bounded_statistical_inquiry_or_evaluation",
        "prediction_authority": false,
        "mou_rules": [
          "AB-AGENT-01",
          "AB-AGENT-02",
          "AB-AGENT-03",
          "AB-AGENT-04"
        ],
        "minimum_sponsors": 2,
        "sponsor_type": "founding_member"
      }
