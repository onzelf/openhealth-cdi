      ],
      "mou_rules": [
        "AB-CUSTODY-01",
        "AB-CUSTODY-02",
        "AB-CUSTODY-03",
        "AB-CUSTODY-04",
        "AB-CUSTODY-05",
        "AB-CUSTODY-06"
      ]
    },
    "research_roles": {
      "other_tissue_reader": {
        "description": "Research role limited to explicitly granted other-tissue classes.",
        "minimal_poc_query_scope": [
          "mucus",
          "normal_colon_mucosa",
          "lymphocytes"
        ],
        "does_not_imply_access_to": [
          "cancer_associated_stroma",
          "colorectal_adenocarcinoma_epithelium",
          "background"
        ],
        "mou_rules": [
          "AB-QUERY-01",
          "AB-QUERY-02",
          "AB-QUERY-03",
          "AB-QUERY-04",
          "AB-QUERY-06",
          "AB-QUERY-08"
        ]
      },
      "cancer_associated_tissue_reader": {
        "description": "Separate research role required to query cancer-associated tissue classes.",
        "query_scope": [
          "cancer_associated_stroma",
          "colorectal_adenocarcinoma_epithelium"
        ],
        "does_not_imply_access_to": [
          "background"
        ],
        "mou_rules": [
          "AB-QUERY-01",
          "AB-QUERY-02",
          "AB-QUERY-05",
          "AB-QUERY-06",
          "AB-QUERY-08"
        ]
      }
    },
    "participation_grades": {
