        "approved_model_updates",
        "approved_evaluation_information",
        "required_research_evidence"
      ],
      "operational_parameters_not_constitutional": [
        "sample_allocation",
        "random_seed",
        "optimizer",
        "number_of_rounds",
        "computing_equipment"
      ],
      "mou_rules": [
        "AB-TRAIN-01",
        "AB-TRAIN-02",
        "AB-TRAIN-03",
        "AB-TRAIN-04",
        "AB-CONTRIB-01",
        "AB-CONTRIB-02",
        "AB-CONTRIB-03"
      ]
    },
    "shared_model_custody": {
      "classification": "protected_shared_research_asset",
      "custody": "protected_environment_controlled_for_the_collaboration",
