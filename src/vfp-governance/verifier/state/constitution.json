      "proof_of_legitimate_possession_required": true,
      "holder_mismatch_result": "DENY",
      "bearer_possession_alone_is_insufficient": true,
      "mou_rules": [
        "AB-HOLDER-01",
        "AB-HOLDER-02",
        "AB-HOLDER-03",
        "AB-HOLDER-04"
